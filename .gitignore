# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# Intermediates produced by md2docx.py
_body.md
_content.docx

# Source Markdown documents (place your own .md here, not tracked)
input/*.md

# Corporate template (provide your own; not tracked)
templates/*.docx

# Generated Word output (regenerate with run.bat)
output/*.docx

# Sensitive original template backup (keep local only)
archive/template_original.docx

# Historical scripts/reports (kept locally, not tracked)
archive/*.py
archive/*.md

# Word / Office temp & lock files
~$*.docx
~$*.doc*
*.tmp

# OS
Thumbs.db
.DS_Store
